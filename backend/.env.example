# Security & AI Controls
ENVIRONMENT=production
AI_ENABLED=true
AI_RATE_LIMIT=5
AI_DAILY_LIMIT=50
AUTH_RATE_LIMIT=5
MAX_PROMPT_LENGTH=2000

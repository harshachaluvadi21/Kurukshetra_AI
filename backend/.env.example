DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kurukshetra

CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
